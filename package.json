{
  "name": "llm-is-not-an-agent",
  "version": "1.0.0",
  "private": true,
  "description": "LLM ≠ Agent: build Campus Buddy from a raw LLM call to a Deep Agents harness.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "1": "tsx steps/01-llm/index.ts",
    "2": "tsx steps/02-chatbot/index.ts",
    "3": "tsx steps/03-agent-loop/start.ts",
    "4": "tsx steps/04-create-agent/start.ts",
    "doctor": "tsx scripts/doctor.ts",
    "3:solution": "tsx scripts/reveal.ts 3",
    "4:solution": "tsx scripts/reveal.ts 4",
    "5a": "tsx steps/05-deep-agents/a-state-backend/index.ts",
    "5b": "tsx steps/05-deep-agents/b-filesystem-backend/index.ts",
    "5c": "tsx steps/05-deep-agents/c-skills/index.ts",
    "5d": "tsx steps/05-deep-agents/d-memory/index.ts",
    "check": "tsx scripts/check.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "@langchain/core": "1.2.12",
    "@langchain/google": "0.2.7",
    "@langchain/langgraph": "1.4.18",
    "deepagents": "1.14.1",
    "dotenv": "18.0.3",
    "langchain": "1.5.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
