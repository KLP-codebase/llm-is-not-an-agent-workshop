# 1. Get a free key at https://aistudio.google.com/apikey (sign in with Google, no card needed)
# 2. Copy this file to .env and paste your key below
GEMINI_API_KEY=paste-your-key-here

# Model for steps 1 to 4 (fast and cheap)
MODEL=gemini-3.5-flash-lite

# Model for step 5 (Deep Agents needs a stronger model)
HARNESS_MODEL=gemini-3.8-flash
